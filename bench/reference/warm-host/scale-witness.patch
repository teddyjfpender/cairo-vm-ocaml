@@ -3287,3 +3287,20 @@ async fn test_proof_facts_versions_and_program_hashes() {
 
     test_builder.build_and_run().await.perform_default_validations();
 }
+
+#[tokio::test]
+async fn test_export_scale_witness() {
+    let n: usize = std::env::var("SCALE_TX").unwrap().parse().unwrap();
+    let blocks: usize = std::env::var("SCALE_BLOCKS").unwrap().parse().unwrap();
+    let (mut b, []) = TestBuilder::create_standard_with_config([], TestBuilderConfig { use_kzg_da: true, ..Default::default() }).await;
+    for i in 0..n {
+        let address = ContractAddress::try_from(Felt::from(0x12340000_u64 + (i % 64) as u64)).unwrap();
+        b.add_fund_address_tx(address, 1_000_000 + i as u128);
+    }
+    b.divide_transactions_into_n_blocks(blocks);
+    let job = b.build().await;
+    let file = std::fs::File::create_new(std::env::var_os("SCALE_OUTPUT").unwrap()).unwrap();
+    let mut writer = std::io::BufWriter::new(file);
+    serde_json::to_writer(&mut writer, &job.os_hints).unwrap();
+    std::io::Write::flush(&mut writer).unwrap();
+}
