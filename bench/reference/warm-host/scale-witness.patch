+fn serialize_component_hashes<S: serde::Serializer>(
+    hashes: &HashMap<ClassHash, ContractClassComponentHashes>, serializer: S,
+) -> Result<S::Ok, S::Error> {
+    use serde::Serialize;
+    let out: BTreeMap<_, _> = hashes.iter().map(|(k, v)| (k, serde_json::json!({
+        "contract_class_version": v.contract_class_version,
+        "external_functions_hash": v.external_functions_hash.0,
+        "l1_handlers_hash": v.l1_handlers_hash.0,
+        "constructors_hash": v.constructors_hash.0,
+        "abi_hash": v.abi_hash,
+        "sierra_program_hash": v.sierra_program_hash
+    }))).collect();
+    out.serialize(serializer)
+}
diff --git a/crates/starknet_os_flow_tests/src/tests.rs b/crates/starknet_os_flow_tests/src/tests.rs
