diff --git a/src/native/warm_clock.h b/src/native/warm_clock.h
new file mode 100644
index 0000000..6f9aa7e
--- /dev/null
+++ b/src/native/warm_clock.h
@@ -0,0 +1,24 @@
+/* Single-domain, diagnostic-build exclusive timers. */
+#include <time.h>
+
+static int warm_phase;
+static uint64_t warm_last, warm_duration[12];
+
+static uint64_t warm_now(void) {
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return (uint64_t)t.tv_sec * 1000000000 + t.tv_nsec;
+}
+
+static int warm_switch(int next) {
+  uint64_t now = warm_now();
+  int old = warm_phase;
+  if (old) warm_duration[old] += now - warm_last;
+  warm_last = now;
+  warm_phase = next;
+  return old;
+}
+
+#define WARM_BUILTIN(call) do { int old = warm_switch(4); call; warm_switch(old); } while (0)
+CAMLprim value cvm_warm_switch(value next) { return Val_int(warm_switch(Int_val(next))); }
+CAMLprim value cvm_warm_get(value phase) { return Val_long(warm_duration[Int_val(phase)]); }
