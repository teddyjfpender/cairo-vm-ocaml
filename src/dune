(library
 (name cairovm)
 (public_name cairo-vm-ocaml)
 (libraries zarith yojson)
 (ocamlopt_flags (:standard -O3 -unboxed-types -inline 200 -unsafe))
 (flags (:standard -w -32-26-27-35-37-69))
 (foreign_stubs
  (language c)
  (names felt_stubs cpu_kernel)
  (flags (:standard -O3 (:include native_flags.sexp) -I/opt/homebrew/include -I/usr/local/include))))

(rule
 (target pedersen_table.h)
 (deps constants.h)
 (action
  (with-stdout-to %{target}
   (run %{exe:../scripts/gen_pedersen_table.exe} %{dep:constants.h}))))

(rule
 (target native_flags.sexp)
 (action
  (with-stdout-to %{target}
   (run %{exe:../scripts/native_flags.exe} %{ocaml-config:architecture}))))
