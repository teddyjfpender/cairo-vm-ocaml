(rule
 (target pedersen_table.h)
 (deps constants.h)
 (action
  (with-stdout-to %{target}
   (run %{exe:../../scripts/gen_pedersen_table.exe} %{dep:constants.h}))))

(rule
 (target native_flags.sexp)
 (action
  (with-stdout-to %{target}
   (run %{exe:../../scripts/native_flags.exe} compile %{ocaml-config:architecture} %{profile} %{env:OXC_PGO_PROFILE=} %{env:OXC_LIBDEFLATE=} %{env:OXC_OPENSSL=} %{env:OXC_TARGET_CPU=} %{env:OXC_PIE_ARCHIVE=}))))

(rule
 (target native_link_flags.sexp)
 (action
  (with-stdout-to %{target}
   (run %{exe:../../scripts/native_flags.exe} link %{profile} %{env:OXC_LIBDEFLATE=} %{env:OXC_OPENSSL=} %{env:OXC_PIE_ARCHIVE=}))))
